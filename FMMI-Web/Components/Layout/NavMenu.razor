@using Microsoft.EntityFrameworkCore.Metadata.Internal
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IAlarmLogService _alarmLogService
@inject IServiceScopeFactory _scopeFactory


<nav class="navbar navbar-expand-lg py-0 navbarColor">
    <div class="container-fluid">
       

        <a href="/"><img class="navbar-brand" src="/logotelemetri1.png" height="50" width="50" /></a>

    
        <NavLink class="ms-2" href="/DivicesOverviewPage">
            <div class="text-white">Devices</div>
        </NavLink>
        
        @if (_alarmCount > 0)
        {  
            <NavLink class="ms-2" href="/AlarmOverview">
                <i class="bi bi-bell-fill text-danger pointer position-relative">

                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                   @_alarmCount
                </span>
                </i>

            </NavLink>
        }

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                 <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                  
                        </li>
                        <li class="nav-item">
                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group">
                                    <AuthorizeView Context="AdminDropdown">
                                        <button class="btn btn-info btn-sm py-0">@context.User.Identity?.Name</button>
                                        <button type="button" class="btn btn-info dropdown-toggle dropdown-toggle-split btn-sm py-0" data-bs-toggle="dropdown"></button>
                                        <ul class="dropdown-menu dropdown-menu-lg-end">
                                            <li>
                                                <NavLink class="dropdown-item" href="/admin" Match="NavLinkMatch.All">
                                                    <i class="fa-solid fa-calendar-days fa-fw"></i> Administration
                                                </NavLink>
                                            </li>
                                        </ul>
                                     </AuthorizeView> 
                                </div>
                                <NavLink class="btn btn-danger btn-sm py-0" href="/logout" title="Logout">
                                    <i class="fa-solid fa-right-from-bracket fa-fw ">Logout</i>
                                </NavLink>
                            </div>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>
@code {
    private HubConnection? _hubConnection;
    private string? currentUrl;

    private int _alarmCount;

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
           .WithUrl(NavigationManager.ToAbsoluteUri("/alarmHub"))
           .WithAutomaticReconnect()
           .Build();

        //currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        //NavigationManager.LocationChanged += OnLocationChanged;

        _hubConnection.On("NewAlarm", async () =>
        {
            await InvokeAsync(async () =>
            {
                using var scope = _scopeFactory.CreateScope();

                var scopeService = scope.ServiceProvider.GetRequiredService<IAlarmLogService>();

                Result<int> countResult = await scopeService.GetCountOnActiceAlarmlogs();
                if (countResult.IsSucces)
                {
                    _alarmCount = countResult.Data;
                }
                else
                {
                    _alarmCount = 0;
                }
                StateHasChanged();
            });
        });
        Result<int> countResult = await _alarmLogService.GetCountOnActiceAlarmlogs();
        if (countResult.IsSucces)
        {
            _alarmCount = countResult.Data;
        }
        await _hubConnection.StartAsync();
        StateHasChanged();
    }
    
  

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
