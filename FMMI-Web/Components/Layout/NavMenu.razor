@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-lg navbar-dark bg-dark py-0">
    <div class="container-fluid">
        <a href="/">@* <img class="navbar-brand" src="" height="50" width="130" /> *@FMMI</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group">
                                    <AuthorizeView Roles="Admin" Context="AdminDropdown">
                                        <button type="button" class="btn btn-info dropdown-toggle dropdown-toggle-split btn-sm py-0" data-bs-toggle="dropdown"></button>
                                        <ul class="dropdown-menu dropdown-menu-lg-end">
                                            <li>
                                                <NavLink class="dropdown-item" href="/admin" Match="NavLinkMatch.All">
                                                    <i class="fa-solid fa-calendar-days fa-fw"></i> Administration
                                                </NavLink>
                                            </li>
                                        </ul>
                                    </AuthorizeView>
                                </div>
                                <NavLink class="btn btn-danger btn-sm py-0" href="api/sso/logout" title="Logout">
                                    <i class="fa-solid fa-right-from-bracket fa-fw "></i>
                                </NavLink>
                            </div>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>
@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
