<SfDashboardLayout Columns="6" CellSpacing="@(new double[]{10 ,10})">
        <DashboardLayoutPanels>
        <SfChart ID="tempChart" @ref="linechartObj" Title=''>
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime"
                                   LabelFormat="HH:mm" IntervalType="IntervalType.Minutes" Title="Tid" EdgeLabelPlacement="EdgeLabelPlacement.Shift" />
                <ChartPrimaryYAxis Title="°C" />
                <ChartSeriesCollection>
                    <ChartSeries DataSource="_telemetriDTOs" XName="XValue" YName="YValue"
                                 Type="ChartSeriesType.Line" Name="Temperatur" Width="2">
                        <ChartMarker Visible="true" Height="6" Width="6"></ChartMarker>
                        <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                    </ChartSeries>
                </ChartSeriesCollection>
            </SfChart>
    </DashboardLayoutPanels>
</SfDashboardLayout>


@code 
{
    [Parameter]
    public int DeviceId { get; set; }
    SfChart linechartObj;

    private List<ShowAlarmLogDTO> _alarmLogDTOs = new List<ShowAlarmLogDTO>();
    private List<DataDTO> _telemetriDTOs = [];
    private ShowDeviceDTO _deviceDTO = new();

    protected async override Task OnInitializedAsync()
    {
    }

    protected async override Task OnParametersSetAsync()
    {
        await GetDeviceById();
        StateHasChanged();
    }

    private async Task GetDataByDeviceId()
    {
        var data = await _telemetriService.GetDataByDeviceIdAsync(DeviceId);
        if (data is not null)
        {
            _telemetriDTOs = data.Data;
        }

    }

    private async Task GetLogsData()
    {
        var logs = await (_alarmLogService.GetAllActiveAlarmlogs());
        if (logs is not null)
        {
            _alarmLogDTOs = logs.Data;
        }

    }

    private async Task GetDeviceById()
    {
        var deviceDTO = await _deviceService.GetDeviceById(DeviceId);
        if (deviceDTO is not null)
        {
            _deviceDTO = deviceDTO.Data;
        }

        await GetDataByDeviceId();
        await GetLogsData();

    }

    private void CreateDevice()
    {
        _deviceService.CreateDevice(_deviceDTO);
    }
}
