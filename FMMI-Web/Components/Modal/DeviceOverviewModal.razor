@using Blazored.Toast.Services
@using FMMI_Domain.Entities
@using FMMI_Service.DTO.Alarm
@using FMMI_Service.DTO.Data
@using FMMI_Service.DTO.Device
@using FMMI_Service.Services.DeviceServices
@using FMMI_Service.Services.TelemetriService
@using System.Text
@using FMMI_Web.Components.Device
@using FMMI_Web.Components.Pages.AdminComponents
@using MQTTnet
@using MQTTnet.Client
@using System.Text.Json
@inject IToastService _toastService
@inject IAlarmLogService _alarmLogService
@inject IDeviceService _deviceService
@inject ITelemetriService _telemetriService


<div class="d-flex justify-content-between">
    <p class="fw-bold fs-5">
        @Device.Name
    </p>
    <div class="d-flex justify-content-center">

        <button class="btn btn-secondary me-2" name="rediger-enhed" @onclick="() => OpenEditModal()">Rediger enhed</button>
        <button class="btn btn-danger me-2" name="slet-enhed" @onclick="OpenConfirmDeleteModal">Slet enhed</button>
        <button class="btn btn-success" name="opret-alarm" @onclick="OpenAlarmLogModal">Alarm log</button>
    </div>
</div>

<DashboardComponent />

@code 
{
    private bool _isRealTimeMode = true;
    [Parameter]
    public bool IsRealTimeMode
    {
        get => _isRealTimeMode;
        set
        {
            if (_isRealTimeMode != value)
            {
                _isRealTimeMode = value;
            }
        }
    }
    [Parameter]
    public ShowDeviceDTO Device { get; set; }
    private List<ShowAlarmLogDTO> _alarmLogDTOs = new List<ShowAlarmLogDTO>();
    private List<Data> _telemetriDTOs = [];

    [CascadingParameter] 
    public IModalService Modal { get; set; } = default!;

    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = null!;

    [Parameter]
    public EventCallback CreateEvent { get; set; }


    private async Task OpenEditModal()
    {
        var parameters = new ModalParameters();
        parameters.Add(nameof(EditDeviceComponent.DeviceId), Device.Id);

        var options = new ModalOptions()
         {
             Size = ModalSize.Large,
             Position = ModalPosition.Middle,
             HideHeader = true,
        };

        var modal = Modal!.Show<EditDeviceComponent>(parameters, options);

        var result = await modal.Result;

        if (result.Cancelled)
        {
            _toastService.ShowError("Redigering af enhed blev annulleret");
        }
        else if (result.Confirmed)
        {
            _toastService.ShowSuccess("Enhed blev redigeret");
            Close();
            await CreateEvent.InvokeAsync();
            await InvokeAsync(StateHasChanged);
            
        }
    }
    async Task Close()
            => await BlazoredModal.CloseAsync(ModalResult.Ok(true));
    private async Task OpenAlarmLogModal()
    {
        var parameters = new ModalParameters();
        parameters.Add(nameof(AlarmLogsOverview.DeviceId), Device.Id);

        var options = new ModalOptions()
         {
             Size = ModalSize.Large,
             Position = ModalPosition.Middle,
             HideHeader = true,
         };

        var modal = Modal!.Show<AlarmLogsOverview>(parameters, options);

        var result = await modal.Result;

        if (result.Cancelled)
        {
            _toastService.ShowError("Åbning af alarm log blev annulleret");
        }
        else if (result.Confirmed)
        {
            _toastService.ShowSuccess("Alarm log blev åbnet");
        }
    }
    private async Task GetLogsData()
    {
        var logs = await (_alarmLogService.GetAllActiveAlarmlogs());
        if (logs is not null)
        {
            _alarmLogDTOs = logs.Data;
        }

    }
    private void OpenConfirmDeleteModal()
    {
        ModalParameters parameter = new();
        parameter.Add(nameof(ConfrimModalComponent.CreateEvent), EventCallback.Factory.Create(this, () => DeleteDevice()));

        parameter.Add(nameof(ConfrimModalComponent.Text), "Er du sikker på du vil slette denne enhed?");

        Modal.Show<ConfrimModalComponent>(parameter);
    }
    private async Task DeleteDevice()
    {
        Result result = await _deviceService.DeleteDevice(Device.Id);
        if (result.IsSucces)
        {
            _toastService.ShowSuccess(result.Message);
            await CreateEvent.InvokeAsync();
            await BlazoredModal.CloseAsync(ModalResult.Ok(true));
        }
        else
        {
            _toastService.ShowError(result.Message);
        }
    }
}
