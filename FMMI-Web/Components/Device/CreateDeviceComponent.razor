@using FMMI_Service.DTO.Device
@using FMMI_Service.Services.DeviceServices
@inject IDeviceService _deviceService;

<InputText @bind-Value="_name" />
<button type="submit" @onclick="CreateDevice">Opret </button>
<button type="submit">Anullere </button>
@code {
    [Parameter]
    public int MachineId { get; set; }

    [Parameter]
    public int LocationId { get; set; }

    [Parameter]
    public EventCallback CreateEvent { get; set; }

    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = null!;

    private string _name;

    private CreateDeviceDTO _createDevice = new();

    private async Task CreateDevice()
    {
        if (!string.IsNullOrWhiteSpace(_name))
        {
            _createDevice.Name = _name;
            _createDevice.MachineId = MachineId;
            Result result = await _deviceService.CreateDeviceAsync(_createDevice);
            if (result.IsSucces)
            {
                _toastService.ShowSuccess(result.Message);
                await CreateEvent.InvokeAsync();
                await BlazoredModal.CloseAsync(ModalResult.Ok(true));
            }
            else
            {
                _toastService.ShowError(result.Message);
            }
            
        }


    }
}
