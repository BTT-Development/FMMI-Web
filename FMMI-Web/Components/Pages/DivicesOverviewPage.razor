@page "/DivicesOverviewPage"
@using FMMI_Service.DTO.Device
@using FMMI_Service.DTO.Location
@using FMMI_Service.DTO.Machine
@using FMMI_Service.Result
@using FMMI_Service.Services.DeviceServices
@using FMMI_Service.Services.MachineServices
@using FMMI_Web.Components.Device
@inject ILocationService _locationService
@inject IMachineService _machineService
@inject IDeviceService _deviceService
@rendermode InteractiveServer
@attribute [Authorize]

<div class="d-flex justify-content-start">
    <div class="col-2 align-items-start  border border-dark-subtle border-top-0 border-bottom-0 border-start-0 min-vh-100 bg-body-secondary border-1">
        <div class="d-flex justify-content-center">
            <p>Lokationer</p>
        </div>
        @foreach (ShowLocationDTO item in _locations)
        {
            int index = _locations.IndexOf(item);
            <div class="pointer p-1 m-2 rounded-3 @(_pickedLocation[index] ? "bg-secondary-subtle" : "")" @onclick="() => ClickLocationName(item.ID, index)">@item.Name</div>
        }
    </div>
    @if (_showMachines)
     {
        <div class="col-2 align-items-start border border-dark-subtle border-top-0 border-bottom-0 border-start-0 min-vh-100 bg-body-secondary border-1">
            <div class="d-flex justify-content-center ">
                <p>Maskiner</p>
            </div>
            @foreach (var item in _machines)
            {
                int index = _machines.IndexOf(item);
                <div class="pointer p-1 m-2 rounded-3 @(_pickedMachine[index] ? "bg-secondary-subtle" : "")" @onclick="() => ClickMachineName(item.Id, index)">@item.Name</div>
            }
            
        </div>
    }
    @if (_showDevices)
    {
        
    <div class="col-8 min-vh-100 bg-white">
    <div class="d-flex justify-content-between align-items-center ps-2 pe-2">
        <div class="flex-grow-1 text-center">
            <p class="mb-0">Maskiner</p>
        </div>
        <AuthorizeView Roles="Sikkerhedspersonale">
            <button class="btn btn-secondary" @onclick="OpenCreateDeviceModal">
                <i class="bi bi-plus-square-fill"></i>
            </button>
        </AuthorizeView>
    </div>
        @foreach (var item in _devices)
            {
                <FMMI_Web.Components.Device.DeviceComponent Device="item"  CreateEvent="() => LoadDevicesByMachineId(_pickedMachineId)"/>
            }
    </div>
    }

</div>

@code {
    private List<(string name, int id)> _listMachineNameAndId = new();

    private List<ShowLocationDTO> _locations = new();

    private List<ShowMachineDTO> _machines = new();

    private List<ShowDeviceDTO> _devices = new();

    [CascadingParameter] 
    public IModalService Modal { get; set; } = default!;

    bool _showMachines = false;

    bool _showDevices = false;

    private bool[] _pickedLocation;

    private bool[] _pickedMachine;

    private int _pickedLocationId;

    private int _pickedMachineId;

    protected async override void OnAfterRender(bool first)
    {
        if (!first)
        {
            return;
        }
        Result<List<ShowLocationDTO>> result = await _locationService.GetAllLocations();
        if (result.IsSucces)
        {
            _locations = result.Data;
            _pickedLocation = new bool[_locations.Count];
        }
        StateHasChanged();
    }
    private async Task ClickLocationName(int id, int index)
    {
        _machines.Clear();
        _devices.Clear();
        Result<List<ShowMachineDTO>> result = await _machineService.GetMachinesByLocationId(id);
        if (result.IsSucces)
        {
            _machines = result.Data;
        }
        _pickedLocationId = id;
        _pickedLocation = new bool[_locations.Count];
        _pickedLocation[index] = true;
        _pickedMachine = new bool[_machines.Count];
        _showMachines = true;
        _showDevices = false;
        StateHasChanged();
    }
    private async Task ClickMachineName(int id, int index)
    {
        _devices.Clear();
        await LoadDevicesByMachineId(id);
        _pickedMachineId = id;
        _pickedMachine = new bool[_machines.Count];
        _pickedMachine[index] = true;

        _showDevices = true;
        StateHasChanged();
    }
    private async Task LoadDevicesByMachineId(int id)
    {
        _devices.Clear();
        Result<List<ShowDeviceDTO>> result = await _deviceService.GetDevicesByMachineId(id);
        if (result.IsSucces)
        {
            _devices = result.Data;
        }
        StateHasChanged();
    }
    private async Task OpenCreateDeviceModal()
    {
        var parameters = new ModalParameters();
        parameters.Add(nameof(CreateDeviceComponent.LocationId), _pickedLocationId);
        parameters.Add(nameof(CreateDeviceComponent.MachineId), _pickedMachineId);
        parameters.Add(nameof(CreateDeviceComponent.CreateEvent), EventCallback.Factory.Create(this, () => LoadDevicesByMachineId(_pickedMachineId)));

        var options = new ModalOptions()
        {
            Size = ModalSize.Medium,
            Position = ModalPosition.Middle,
            HideHeader = true,
        };

        var modal = Modal!.Show<CreateDeviceComponent>(parameters, options);

        var result = await modal.Result;

        if (result.Cancelled)
        {
            Console.WriteLine("Modal was cancelled");
        }
        else if (result.Confirmed)
        {
            Result<List<ShowDeviceDTO>> resultDeviceList = await _deviceService.GetDevicesByMachineId(_pickedMachineId);
            if (resultDeviceList.IsSucces)
            {
                _devices.Clear();
                _devices = resultDeviceList.Data;
                StateHasChanged();
            }
        }
    }
}
