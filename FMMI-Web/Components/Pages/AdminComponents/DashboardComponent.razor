@using Blazored.Toast.Services
@using FMMI_Domain.Entities
@using FMMI_Service.DTO.Data
@using FMMI_Service.Services.TelemetriService
@using MQTTnet
@using MQTTnet.Client
@using MQTTnet.Extensions.TopicTemplate;
@using System.Text.Json
@using System.Text
@inject IToastService _toastService
@inject ITelemetriService _service


<div class="d-flex justify-content-center my-3">
    <div class="intervalStyle">
        <ChooseIntervalComponent OnModeChanged="@OnRealtimeModeChanged" />
        @if (IsRealTimeMode)
        {
            <div class="form-group">
                <label for="selection" class="block text-sm font-medium text-gray-700 mb-1">Vælg interval:</label>
                <select id="selection"
                        class="form-select w-full p-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 shadow-sm"
                        @bind="_selectedValue">

                    <option value="">-- Vælg --</option>
                    <option>5 sekunder</option>
                    <option>10 sekunder</option>
                    <option>30 sekunder</option>
                </select>
            </div>
        }
    </div>
</div>
<div class="content">
    <SfDashboardLayout Columns="6" CellSpacing="@(new double[]{10 ,10})">
        <DashboardLayoutPanels>
            <SfChart ID="tempChart" @ref="tempChartObj" Title='@(!IsRealTimeMode ? "Temperatur (sidste 24 timer) °C" : "Temperatur ( RealTime )")'>
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime"
                                   LabelFormat='@(IsRealTimeMode ? "HH:mm:ss" : "HH:mm")' IntervalType="@(IsRealTimeMode ? IntervalType.Seconds : IntervalType.Minutes)" Title="Tid" EdgeLabelPlacement="EdgeLabelPlacement.Shift" />
                <ChartPrimaryYAxis Title="°C" />
                <ChartSeriesCollection>
                    <ChartSeries DataSource="@TemperaturData" XName="XValue" YName="YValue"
                                 Type="ChartSeriesType.Line" Name="Temperatur" Width="2">
                        <ChartMarker Visible="true" Height="6" Width="6"></ChartMarker>
                        <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                    </ChartSeries>
                </ChartSeriesCollection>
            </SfChart>

            <SfChart ID="humidityChart" @ref="humidityChartObj" Title='@(!IsRealTimeMode ? "Luftfugtighed (sidste 24 timer) %" : "Luftfugtighed ( RealTime )")'>
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime"
                                   LabelFormat='@(IsRealTimeMode ? "HH:mm:ss" : "HH:mm")' IntervalType="@(IsRealTimeMode ? IntervalType.Seconds : IntervalType.Minutes)" Title="Tid" EdgeLabelPlacement="EdgeLabelPlacement.Shift" />
                <ChartPrimaryYAxis Title="%" />
                <ChartSeriesCollection>
                    <ChartSeries DataSource="@FugtighedData" XName="XValue" YName="YValue"
                                 Type="ChartSeriesType.Line" Name="Luftfugtighed" Width="2">
                        <ChartMarker Visible="true" Height="6" Width="6"></ChartMarker>
                        <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                    </ChartSeries>
                </ChartSeriesCollection>
            </SfChart>
        </DashboardLayoutPanels>
    </SfDashboardLayout>
</div>

@code
{
    private bool _isRealTimeMode = true;
    [Parameter]
    public bool IsRealTimeMode
    {
        get => _isRealTimeMode;
        set
        {
            if (_isRealTimeMode != value)
            {
                _isRealTimeMode = value;
            }
        }
    }

    public List<Data> telemetriData = new List<Data>();
    SfChart tempChartObj;
    SfChart humidityChartObj;
    private object[] Value = new object[] { new DateTime(2025, 01, 01), new DateTime(2025, 10, 01) };
    private string _selectedValue;

    private MqttTopic _topic { get; set; }
    private IMqttClient _mqttClient;
    private MqttFactory _mqttFactory;

    public List<ChartData> TemperaturData = new();
    public List<ChartData> FugtighedData = new();

    private async Task MqttConnect()
    {
        try
        {
            _mqttFactory = new MqttFactory();
            _mqttClient = _mqttFactory.CreateMqttClient();

            _mqttClient.ApplicationMessageReceivedAsync -= HandleApplicationMessageReceivedAsync;
            _mqttClient.ApplicationMessageReceivedAsync += HandleApplicationMessageReceivedAsync;

            MqttClientOptions mqttClientOptions = new MqttClientOptionsBuilder()
                .WithTcpServer("49987f455bc94d2183a5075a9fa78344.s1.eu.hivemq.cloud")
                .WithCredentials("Worker", "fMMIWORKER1234")
                .WithTlsOptions(_ => _.UseTls())
                .WithProtocolVersion(MQTTnet.Formatter.MqttProtocolVersion.V311)
                .WithCleanSession()
                .WithKeepAlivePeriod(new TimeSpan(600000000))
                .Build();
            if (!_mqttClient.IsConnected)
            {
                await _mqttClient.ConnectAsync(mqttClientOptions);
                await _mqttClient.SubscribeAsync("device/+/realtime/#");
            }
            Console.WriteLine("Realtids subscribe");

        }
        catch (Exception)
        {
            throw;
        }

    }
    private async Task OnRealtimeModeChanged(bool newMode)
    {
        IsRealTimeMode = newMode; 
        TemperaturData = new();
        FugtighedData = new();
        if (IsRealTimeMode)
        {
            await MqttConnect();
        }
        else
        {
            await StopRealtimeAsync();
            await GetHistorikData();
        }
        await InvokeAsync(StateHasChanged);
    }
    private async Task StopRealtimeAsync()
    {
        try
        {
            if (_mqttClient?.IsConnected == true)
            {
                await _mqttClient.DisconnectAsync();
                _mqttClient.ApplicationMessageReceivedAsync -= HandleApplicationMessageReceivedAsync;

            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MQTT stop error: {ex.Message}");
        }
    }
    private async Task GetHistorikData()
    {
        try
        {
            telemetriData = _service.GetData();
            
            var now = DateTime.Now;
            var tweentyFourHours = now.AddHours(-6);

            // Temperatur
            var tempLast6h = telemetriData
                .Where(td => td.DataType.TypeName == "Temperature" && td.Dates >= tweentyFourHours)
                .GroupBy(td => new DateTime(td.Dates.Year, td.Dates.Month, td.Dates.Day, td.Dates.Hour, td.Dates.Minute / 5 * 5, 0)) // gennemsnit pr. time
                .Select(g => new ChartData { XValue = g.Key, YValue = g.Average(x => x.Value) })
                .OrderBy(g => g.XValue)
                .ToList();

            // Luftfugtighed
            var humidityLast6h = telemetriData
                .Where(td => td.DataType.TypeName == "Humidity" && td.Dates >= tweentyFourHours)
                .GroupBy(td => new DateTime(td.Dates.Year, td.Dates.Month, td.Dates.Day, td.Dates.Hour, td.Dates.Minute / 5 * 5, 0))
                .Select(g => new ChartData { XValue = g.Key, YValue = g.Average(x => x.Value) })
                .OrderBy(g => g.XValue)
                .ToList();

            TemperaturData = tempLast6h;
            FugtighedData = humidityLast6h;
        }
        catch (Exception)
        {
            _toastService.ShowError("Error, prøv igen");
        }

    }
    private async Task HandleApplicationMessageReceivedAsync(MqttApplicationMessageReceivedEventArgs e)
    {
        try
        {
            var topic = e.ApplicationMessage.Topic;
            var payload = Encoding.UTF8.GetString(e.ApplicationMessage.PayloadSegment);
            Console.WriteLine($"Received: {topic} => {payload}");

            if (!string.IsNullOrEmpty(payload))
            {
                if (topic.Contains("realtime"))
                {
                    Data data = JsonSerializer.Deserialize<Data>(Encoding.UTF8.GetString(e.ApplicationMessage.Payload));
                    if (data is null)
                        return;

                    await InvokeAsync(() =>
                    {
                        if (data.DataTypeID == 1)
                        {
                            TemperaturData.Add(new ChartData { XValue = DateTime.Now, YValue = data.Value });
                            if (TemperaturData.Count > 50) TemperaturData.RemoveAt(0);
                        }
                        else if (data.DataTypeID == 2)
                        {
                            FugtighedData.Add(new ChartData { XValue = DateTime.Now, YValue = data.Value });
                            if (FugtighedData.Count > 50) FugtighedData.RemoveAt(0);
                        }

                        StateHasChanged();
                    });
                }
            }
        }
        catch (Exception ex)
        {
        }
    }

    public class ChartData
    {
        public DateTime XValue { get; set; }
        public double YValue { get; set; }
        public string X { get; set; }
        public double Y { get; set; }
        public string Country { get; set; }
        public string X1 { get; set; }
        public double Y1 { get; set; }
        public double Y2 { get; set; }
        public double Y3 { get; set; }
        public double Y4 { get; set; }
    }
 }

<style>
    #linechart, #grid, #chart1, #chart, #range {
        height: 100% !important;
        width: 100% !important;
    }
</style>