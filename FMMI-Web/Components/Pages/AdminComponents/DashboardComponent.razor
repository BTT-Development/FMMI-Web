@using FMMI_Domain.Entities
@using FMMI_Service.Services.TelemetriService
@inject ITelemetriService _service


<div class="content">
    <div class="d-flex align-items-center input-group mb-3">
        <div class="input-group-prepend">
            <div class="input-group-text">
                <input type="checkbox" value="1" aria-label="Checkbox for following text input"><a class="ml-2"> Realtids data </a>
                <input type="checkbox" value="2" aria-label="Checkbox for following text input"><a class="ml-2"> Historik data </a>
            </div>
        </div>
    </div>
    <SfDashboardLayout Columns="6" CellSpacing="@(new double[]{10 ,10})">
        <DashboardLayoutPanels>
            <SfChart ID="tempChart" @ref="tempChartObj" Title="Temperatur (sidste 20 timer)">
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime"
                                   LabelFormat="HH:mm" IntervalType="IntervalType.Minutes" Title="Tid" EdgeLabelPlacement="EdgeLabelPlacement.Shift" />
                <ChartPrimaryYAxis Title="°C" />
                <ChartSeriesCollection>
                    <ChartSeries DataSource="@TemperaturData" XName="XValue" YName="YValue"
                                 Type="ChartSeriesType.Line" Name="Temperatur" Width="2">
                        <ChartMarker Visible="true" Height="6" Width="6"></ChartMarker>
                        <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                    </ChartSeries>
                </ChartSeriesCollection>
            </SfChart>

            <SfChart ID="humidityChart" @ref="humidityChartObj" Title="Luftfugtighed (sidste 20 timer)">
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime"
                                   LabelFormat="HH:mm" IntervalType="IntervalType.Minutes" Title="Tid" EdgeLabelPlacement="EdgeLabelPlacement.Shift" />
                <ChartPrimaryYAxis Title="%" />
                <ChartSeriesCollection>
                    <ChartSeries DataSource="@FugtighedData" XName="XValue" YName="YValue"
                                 Type="ChartSeriesType.Line" Name="Luftfugtighed" Width="2">
                        <ChartMarker Visible="true" Height="6" Width="6"></ChartMarker>
                        <ChartTooltipSettings Enable="true"></ChartTooltipSettings>
                    </ChartSeries>
                </ChartSeriesCollection>
            </SfChart>
        </DashboardLayoutPanels>
    </SfDashboardLayout>
</div>

@code
{
    public List<Data> telemetriData = new List<Data>();
    SfChart chartObj;
    SfChart barchartObj;
    SfChart linechartObj;
    SfChart tempChartObj;
    SfChart humidityChartObj;
    private object[] Value = new object[] { new DateTime(2025, 01, 01), new DateTime(2025, 10, 01) };
    
    public List<ChartData> TemperaturData = new();
    public List<ChartData> FugtighedData = new();
    
    protected async  override Task OnInitializedAsync()
    {
        telemetriData = await _service.GetDataAsync();

        var now = DateTime.Now;
        var twelveHoursAgo = now.AddHours(-12);

        // Temperatur
        var tempLast12h = telemetriData
            .Where(td => td.DataType.TypeName == "Temperature" && td.Dates >= twelveHoursAgo)
            .GroupBy(td => new DateTime(td.Dates.Year, td.Dates.Month, td.Dates.Day, td.Dates.Hour, td.Dates.Minute / 5 * 5, 0)) // gennemsnit pr. time
            .Select(g => new ChartData { XValue = g.Key, YValue = g.Average(x => x.Value) })
            .OrderBy(g => g.XValue)
            .ToList();

        // Luftfugtighed
        var humidityLast12h = telemetriData
            .Where(td => td.DataType.TypeName == "Humidity" && td.Dates >= twelveHoursAgo)
            .GroupBy(td => new DateTime(td.Dates.Year, td.Dates.Month, td.Dates.Day, td.Dates.Hour, td.Dates.Minute / 5 * 5, 0))
            .Select(g => new ChartData { XValue = g.Key, YValue = g.Average(x => x.Value) })
            .OrderBy(g => g.XValue)
            .ToList();

        TemperaturData = tempLast12h;
        FugtighedData = humidityLast12h;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) { }


    public class ChartData
    {
        public DateTime XValue { get; set; }
        public double YValue { get; set; }
        public string X { get; set; }
        public double Y { get; set; }
        public string Country { get; set; }
        public string X1 { get; set; }
        public double Y1 { get; set; }
        public double Y2 { get; set; }
        public double Y3 { get; set; }
        public double Y4 { get; set; }
    }
 }

<style>
    #linechart, #grid, #chart1, #chart, #range {
        height: 100% !important;
        width: 100% !important;
    }
</style>